# Copy to deploy/.env.api and fill the real values. This file is committed;
# deploy/.env.api is ignored.
# Quote any value that is not a bare token: JSON, and any URL carrying a
# query string. deploy.sh, the container watchdog unit, and the healthcheck
# procedure all read this file with `set -a; . deploy/.env.api`, and a shell
# drops the double quotes out of JSON and reads NAME=a&b as a backgrounded
# assignment it never hands back. Docker Compose strips the outer quotes, so
# quoting costs nothing. `python3 deploy/healthcheck.py env-file <path>`
# checks a file.

DATABASE_URL=
INTERNAL_API_KEY=
SESSION_ENCRYPTION_KEY=

# Optional model-assisted onboarding calls your own private runtime.
INTELLIGENCE_PROVIDER=hermes_agent
HERMES_AGENT_URL=
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=engagemate-agent
HERMES_AGENT_TIMEOUT_SECONDS=60

# Public origin of the web app, for example https://app.example.com. Email
# links and the MCP setup link use it. There is no default: emails refuse to
# render until it is set.
ENGAGEMATE_WEB_ORIGIN=
# Optional support address shown in email footers. Blank hides the line.
ENGAGEMATE_SUPPORT_EMAIL=

# Public customer Control MCP. It stays off until all three URLs are set.
# Example: MCP_ISSUER=https://mcp.example.com,
# MCP_RESOURCE_URL=https://mcp.example.com/mcp,
# MCP_CONSENT_URL=https://app.example.com/mcp/authorize. Redirect hosts are bare
# hostnames, without schemes, paths, or ports. Loopback callbacks support
# desktop MCP clients.
MCP_ISSUER=
MCP_RESOURCE_URL=
MCP_REDIRECT_HOSTS=localhost,127.0.0.1,::1
MCP_CONSENT_URL=

FINGERPRINT_SEED=
FINGERPRINT_GEO_MAP_JSON='[]'

# Use import for operator-created leases or managed for scheduler purchasing.
# Managed mode maps each exact login geography to IPRoyal product, 30-day plan,
# and location IDs. The scheduler applies the order and monthly spend limits
# below before any purchase.
IPROYAL_MODE=disabled
IPROYAL_ISP_LEASES_JSON='[]'
IPROYAL_GEO_CATALOG_JSON='[]'
# No spare leases are purchased by default.
IPROYAL_SPARE_PER_GEO=0
IPROYAL_MAX_ORDER_QUANTITY=5
# $30 a single order, $30 a calendar month across ALL geographies. The monthly
# total is global; it bounds the rate of new purchases, not the recurring bill
# those leases generate, so spending it every month still compounds.
IPROYAL_MAX_ORDER_COST_CENTS=3000
IPROYAL_MAX_MONTHLY_COST_CENTS=3000
IPROYAL_API_TIMEOUT_SECONDS=15
PROXY_HEALTH_URL=
PROXY_CONNECT_TIMEOUT_SECONDS=5
PROXY_READ_TIMEOUT_SECONDS=10

JOB_LEASE_SECONDS=120
HEARTBEAT_INTERVAL_SECONDS=30
# Hourly, not every 30s. The scheduler enqueues one job per account per local
# day once `schedule_hour` has arrived, so its granularity is already an hour
# and a faster tick buys nothing. It costs, though: on a scale-to-zero Postgres
# every tick resets the idle timer, and at 30s the endpoint never suspends.
# Set WORKER_IDLE_SECONDS in deploy/.env.worker too -- raising this alone
# changes nothing, because the worker polls far more often than the scheduler.
SCHEDULER_INTERVAL_SECONDS=3600
WORKER_ID=

# Failure artifacts remain disabled unless an absolute private path is set.
# Use /srv/artifacts: docker-compose mounts the engagemate-artifacts volume
# there, so diagnostics survive a rebuild. Any other path is thrown away with
# the container. Leave blank only if you accept running blind on failures.
ARTIFACT_DIR=/srv/artifacts

# Public Instagram discovery for brand onboarding. HyperCrawl is used first
# when set; APIFY_TOKEN is the direct fallback.
APIFY_TOKEN=
HYPERCRAWL_URL=
HYPERCRAWL_REST_TOKEN=

# Geography consensus. Several providers are asked where a lease really is,
# and a lease is condemned only when every one that answered agrees it is far
# from the city it was sold as. Leave PROXY_GEO_PROVIDERS blank to keep the
# original single-provider exact-city check.
#
# ip-api.com is deliberately absent: its free tier refuses HTTPS and the
# health path requires it.
PROXY_GEO_PROVIDERS=ipwho.is,ipinfo.io,freeipapi
# 25 miles, calibrated against the 2026-08-17 readings: it keeps a lease nine
# miles from Hempstead and rejects one geolocating to Virginia when it was
# sold as Washington DC.
PROXY_GEO_RADIUS_MILES=25
# Some providers answer an unknown address with a country centroid rather than
# an error. Anything vaguer than this is discarded before it can vote.
PROXY_GEO_MAX_ACCURACY_KM=100
# One point per supported geography. Without an anchor a geography cannot be
# verified, so capture should not accept it either.
PROXY_GEO_ANCHORS_JSON=

# Concurrent leases that may exist purely to serve trials, across every
# geography. A count, not a monthly cap: a lease bills every month.
IPROYAL_MAX_TRIAL_LEASES=5

# Keep collection batches within the validated API limits.
GROWTH_SNAPSHOT_BATCH_SIZE=25
GROWTH_SNAPSHOT_CONCURRENCY=4

# Set WEEKLY_REPORT_FROM to a sender on a verified Resend domain before
# enabling the report timer. Keep both credentials in deploy/.env.api.
RESEND_API_KEY=
WEEKLY_REPORT_FROM=
WEEKLY_REPORT_BATCH_SIZE=25

# Set both canary values for an operator-approved canary, then clear them.
WEEKLY_REPORT_CANARY_USER_ID=
WEEKLY_REPORT_CANARY_RECIPIENT=

# Hosted Instagram sign-in: apply migration0025 and verify the private login
# service before enabling. Set this in BOTH .env.api and .env.web.
HOSTED_LOGIN_ENABLED=false
HOSTED_LOGIN_MAX_SESSIONS=2
