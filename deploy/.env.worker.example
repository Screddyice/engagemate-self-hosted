# Copy to deploy/.env.worker and keep mode 0600. This file is loaded only by
# the worker so the API and scheduler never receive the Hermes API credential.
INTELLIGENCE_PROVIDER=hermes_agent
HERMES_AGENT_URL=http://127.0.0.1:8657/v1/chat/completions
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=engagemate-agent
# Full follower discovery and Story action loop; 60 to 3600 seconds.
HERMES_EXECUTION_TIMEOUT_SECONDS=1800

# Keep execution off until the exact deployed revision passes the fixture gate,
# action canaries, and the 48-hour test-account soak.
INSTAGRAM_EXECUTION_MODE=disabled
EXECUTION_MCP_HOST=127.0.0.1
EXECUTION_MCP_PORT=8766
ENGAGEMATE_EXECUTION_MCP_KEY=
ARTIFACT_DIR=/srv/artifacts

# How long the worker waits before asking for a job again when there was none.
# The default is 5 seconds, which is the single largest source of idle database
# traffic in the stack and, on a scale-to-zero Postgres, enough on its own to
# stop the compute ever suspending.
#
# The endpoint suspends after 300s idle, so idle compute is roughly
#   730 h/month x (300 / WORKER_IDLE_SECONDS)
# because each poll wakes it for the full idle timeout. 5s pins it at 730 h.
# 900s still leaves ~243 h. 1800s brings it to ~122 h.
#
# The cost is pickup latency, not throughput: run_loop only waits when a cycle
# found no job, and drains the queue back to back while work exists. A job
# enqueued just after a poll waits up to this long. Stories live 24 hours.
WORKER_IDLE_SECONDS=30
