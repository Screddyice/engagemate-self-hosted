# Owner's dedicated profile only. API and execution keys are distinct.
# Setup generates these in the ignored profile-local .env.
# API_SERVER_KEY matches HERMES_AGENT_API_KEY in API/worker configuration.
API_SERVER_ENABLED=true
API_SERVER_KEY=
API_SERVER_PORT=8657
API_SERVER_HOST=127.0.0.1
API_SERVER_MODEL_NAME=engagemate-agent
ENGAGEMATE_EXECUTION_MCP_KEY=
HERMES_MAX_ITERATIONS=40
